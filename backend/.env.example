# Backend Environment Variables
# Copy to .env and fill in real values
# NEVER commit the .env file to Git

NODE_ENV=development
PORT=5001
API_PREFIX=/api

# MongoDB — use a local instance or MongoDB Atlas
# NEVER hardcode real credentials here
MONGODB_URI=mongodb+srv://poornateja0079_db_user:poorna@cgis.lhjabhr.mongodb.net/?appName=cgis

# JWT secrets — generate strong random strings
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=25

# AI Service
AI_SERVICE_URL=http://localhost:8000

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cookie secret
COOKIE_SECRET=change-me-to-a-strong-cookie-secret-at-least-32-chars

# Rate limiting
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION_SECONDS=60

# Logging
LOG_LEVEL=info
